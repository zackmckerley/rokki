{
  "name": "@rokki/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "index-once": "tsx --env-file=.env.local src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint stub'",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@rokki/db": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
