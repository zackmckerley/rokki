{
  "name": "@rokki/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/build-help-index.mjs",
    "build": "next build",
    "build:help-index": "node scripts/build-help-index.mjs",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run --config ./vitest.rls.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bundle:analyze": "node scripts/run-with-analyze.mjs",
    "bundle:check": "node scripts/run-with-analyze.mjs && node scripts/check-bundle-size.mjs",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@axiomhq/js": "^1.6.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@rokki/db": "workspace:*",
    "@rokki/sdk": "workspace:*",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.3.1",
    "lucide-react": "^1.16.0",
    "next": "15.5.18",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.2",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "vitest-axe": "^0.1.0"
  }
}
