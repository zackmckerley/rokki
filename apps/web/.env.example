# Supabase — populated by `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_MCP_URL=http://localhost:3001

# Storage
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rokki-files-local

# Email — console logs locally; Resend in staging/prod
EMAIL_PROVIDER=console
RESEND_API_KEY=

# Redis (rate limiting)
REDIS_URL=redis://localhost:6379

# Embeddings (for RAG, Phase 1)
OPENAI_API_KEY=

# KMS (for BYOK envelope encryption)
KMS_PROVIDER=local
KMS_LOCAL_KEY=dev-only-32-byte-key-DO-NOT-USE-IN-PROD

# Observability
# Sentry: server DSN in SENTRY_DSN, browser DSN in NEXT_PUBLIC_SENTRY_DSN
# (usually the same value). Leave blank to disable in dev.
# SENTRY_AUTH_TOKEN/ORG/PROJECT only needed at build time for sourcemap upload.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES=0.1
NEXT_PUBLIC_SENTRY_TRACES=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Axiom: structured event log. Both must be set or logEvent no-ops.
AXIOM_TOKEN=
AXIOM_DATASET=
POSTHOG_KEY=

# Misc
NODE_ENV=development
LOG_LEVEL=debug
